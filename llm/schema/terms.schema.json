{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FundTerms",
  "type": "object",
  "$defs": {
    "term": {
      "type": "object",
      "properties": {
        "value": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "integer"}}
      },
      "required": ["value", "evidence_ids"]
    }
  },
  "properties": {
    "dividend_declaration_timing": {"$ref": "#/$defs/term"},
    "nav_calculation_days": {"$ref": "#/$defs/term"},
    "dividend_payment_form": {"$ref": "#/$defs/term"},
    "reinvestment_frequency": {"$ref": "#/$defs/term"},
    "fund_closed_days": {"$ref": "#/$defs/term"},
    "share_price_target": {"$ref": "#/$defs/term"},
    "expense_ratio": {"$ref": "#/$defs/term"},
    "official_record": {"$ref": "#/$defs/term"}
  },
  "required": [
    "dividend_declaration_timing", "nav_calculation_days", "dividend_payment_form",
    "reinvestment_frequency", "fund_closed_days", "share_price_target", "expense_ratio", "official_record"
  ]
}
